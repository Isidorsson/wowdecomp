+// Downloads just the asked span, for streams that hold no whole file yet
+static bool BaseHttp_ReadRange(TFileStream * pStream, ULONGLONG ByteOffset, void * pvBuffer, DWORD dwBytesToRead)
+{
+    CASC_BLOB FileData;
+    DWORD dwErrCode;
+
+    if((dwErrCode = BaseHttp_Fetch(pStream, &ByteOffset, dwBytesToRead, FileData)) == ERROR_SUCCESS)
+    {
+        memcpy(pvBuffer, FileData.pbData, dwBytesToRead);
+        pStream->Base.Socket.fileDataPos = (size_t)(ByteOffset + dwBytesToRead);
+        return true;
+    }
+
+    SetCascError(dwErrCode);
+    return false;
+}
