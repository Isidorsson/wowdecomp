+// A ranged request accepts nothing but 206 with exactly the asked length
+bool CASC_MIME_RESPONSE::IsRangeRefused() const
+{
+    if(expected_length == CASC_INVALID_SIZE_T || header_length == CASC_INVALID_SIZE_T)
+        return false;
+    return (http_code != 206) || (content_length != expected_length);
+}
