+static bool IsArchiveLocal(TCascStorage * hs, LPBYTE pbArchiveKey)
+{
+    CASC_PATH<TCHAR> ArchivePath(hs->szRootPath, GetSubFolder(PathTypeData), NULL);
+
+    ArchivePath.AppendEKey(pbArchiveKey);
+    return FileAlreadyExists(ArchivePath);
+}
+
+// Downloads only an archived file's span of its CDN archive, kept as a loose file under its own EKey
+static DWORD FetchArchivedSlice(TCascStorage * hs, LPBYTE pbEKey, PCASC_ARCHIVE_INFO pArchiveInfo, CASC_PATH<TCHAR> & LocalPath)
+{
+    CASC_PATH<TCHAR> TempPath(hs->szRootPath, GetSubFolder(PathTypeData), NULL);
+    LPCTSTR szCdnServers = hs->szCdnServers;
+    TCHAR szCdnServer[MAX_PATH] = _T("");
+    ULONGLONG ByteOffset = pArchiveInfo->ArchiveOffs;
+    DWORD dwErrCode = ERROR_FILE_NOT_FOUND;
+
+    LocalPath.Create(hs->szRootPath, GetSubFolder(PathTypeData), NULL);
+    LocalPath.AppendEKey(pbEKey);
+    TempPath.AppendEKey(pbEKey);
+    TempPath.AppendString(_T(".part"), false);
+
+    if(GetLocalFileSize(LocalPath) == pArchiveInfo->EncodedSize)
+        dwErrCode = ERROR_SUCCESS;
+
+    while(dwErrCode != ERROR_SUCCESS && (szCdnServers = ExtractCdnServerName(szCdnServer, _countof(szCdnServer), szCdnServers)) != NULL)
+    {
+        CASC_PATH<TCHAR> RemotePath(URL_SEP_CHAR);
+
+        RemotePath.Create(szCdnServer, hs->szCdnPath, GetSubFolder(PathTypeData), NULL);
+        RemotePath.AppendEKey(pArchiveInfo->ArchiveKey);
+
+        dwErrCode = HttpDownloadFile(RemotePath, TempPath, &ByteOffset, pArchiveInfo->EncodedSize, 0);
+        if(dwErrCode == ERROR_SUCCESS)
+            dwErrCode = PublishLocalFile(TempPath, LocalPath);
+        if(dwErrCode == ERROR_NOT_ENOUGH_MEMORY)
+            break;
+    }
+
+    // The slice is a whole BLTE blob, read like any loose file
+    if(dwErrCode == ERROR_SUCCESS)
+        memset(pArchiveInfo, 0, sizeof(CASC_ARCHIVE_INFO));
+    return dwErrCode;
+}
