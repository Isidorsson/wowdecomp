# cmake -DSOURCE_DIR=<Engine/Source/Retail> -DOUTPUT=<header> -P RetailConverterHash.cmake
# Writes RETAIL_CONVERTER_SOURCE_HASH: one hash over the converter's sources, which keys the converted cache in dev builds.
file(GLOB sources RELATIVE ${SOURCE_DIR} ${SOURCE_DIR}/*.cpp ${SOURCE_DIR}/*.h)
list(FILTER sources EXCLUDE REGEX "^(CacheBudget|CascSource|CascSourceNpc|Checksum|CompressedBlocks|ConvertedCache|DecodedCache|RetailConfig)\\.(cpp|h)$")
list(SORT sources)

set(combined "")
foreach (source IN LISTS sources)
    file(SHA256 ${SOURCE_DIR}/${source} hash)
    string(APPEND combined "${source}:${hash}\n")
endforeach ()
string(SHA256 hash "${combined}")
string(SUBSTRING ${hash} 0 16 hash)

set(header "// Generated by cmake/RetailConverterHash.cmake.\n#define RETAIL_CONVERTER_SOURCE_HASH 0x${hash}ull\n")
set(current "")
if (EXISTS ${OUTPUT})
    file(READ ${OUTPUT} current)
endif ()
if (NOT current STREQUAL header)
    file(WRITE ${OUTPUT} "${header}")
endif ()
